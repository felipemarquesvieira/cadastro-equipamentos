
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    FILE *arquivo;
    char nome[100];
    char patrimonio[30];
    char linha[200];
    int opcao;

    do {
        printf("\n=== CADASTRO DE EQUIPAMENTOS ===\n");
        printf("1 - Cadastrar equipamento\n");
        printf("2 - Listar equipamentos\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("Entrada invalida!\n");
            return 1;
        }
        getchar();

        if (opcao == 1) {
            arquivo = fopen("equipamentos.txt", "a");

            if (arquivo == NULL) {
                printf("Erro ao abrir o arquivo!\n");
                return 1;
            }

            printf("Nome do equipamento: ");
            if (fgets(nome, sizeof(nome), stdin) == NULL) {
                fclose(arquivo);
                return 1;
            }

            printf("Numero do patrimonio: ");
            if (fgets(patrimonio, sizeof(patrimonio), stdin) == NULL) {
                fclose(arquivo);
                return 1;
            }

            fprintf(arquivo, "Equipamento: %s", nome);
            fprintf(arquivo, "Patrimonio: %s", patrimonio);
            fprintf(arquivo, "-------------------------\n");

            fclose(arquivo);
            printf("Equipamento cadastrado com sucesso!\n");

        } else if (opcao == 2) {
            arquivo = fopen("equipamentos.txt", "r");

            if (arquivo == NULL) {
                printf("Nenhum cadastro encontrado.\n");
            } else {
                printf("\n=== EQUIPAMENTOS CADASTRADOS ===\n");

                while (fgets(linha, sizeof(linha), arquivo) != NULL) {
                    printf("%s", linha);
                }

                fclose(arquivo);
            }

        } else if (opcao != 0) {
            printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    printf("Programa encerrado.\n");
    return 0;
}
